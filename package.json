{
  "name": "inclusiapp-ar",
  "version": "1.0.0",
  "private": true,
  "description": "SinalizaAção: Animais em Voga — WebApp de Realidade Aumentada (livro em AR + jogo de cartas) com MindAR e Three.js",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs 8080",
    "models": "python3 tools/convert_models.py",
    "targets": "node tools/compile-targets.mjs",
    "test": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=18"
  }
}
